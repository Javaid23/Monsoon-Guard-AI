# Copy this file to .env and fill in the values. .env is gitignored.
# No quotes, no spaces around the "=".

# --- NASA Earthdata (IMERG rainfall observations) ---
# Register / sign in: https://urs.earthdata.nasa.gov
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# --- ECMWF Data Store, ECDS (TIGGE ensemble forecasts) ---
# ECDS replaced the apps.ecmwf.int Public Datasets service, which was
# decommissioned on 2026-05-27. The old ECMWF_API_KEY / ECMWF_API_EMAIL pair
# no longer works; ECDS uses a single personal access token.
# Token: https://ecds.ecmwf.int/how-to-api
# Accept the TIGGE licence once at
# https://ecds.ecmwf.int/datasets/tigge-forecasts?tab=download
ECDS_URL=https://ecds.ecmwf.int/api
ECDS_PAT=

# --- Audit layer (phase 8+, not needed for the data pipeline) ---
EVM_RPC_URL=
EVM_PRIVATE_KEY=
FORECAST_REGISTRY_ADDRESS=
