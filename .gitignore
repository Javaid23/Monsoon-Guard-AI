# Data (never committed; rebuildable from manifests + scripts).
# Exclude the CONTENTS of data/, not the directory itself: git cannot
# re-include a file whose parent directory is excluded, so "data/" here
# would silently swallow the manifests we do want committed.
data/*
!data/manifests/
data/manifests/*
!data/manifests/*.json
# Job-store state is local scheduling bookkeeping, not a dataset manifest.
data/manifests/tigge_jobs.json

# Secrets
.env
.ecmwfapirc
.netrc

# Environment
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Logs and scratch
logs/
tmp_*/
*.tmp

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Notebooks
.ipynb_checkpoints/

# cfgrib index caches (should not appear: indexpath is disabled)
*.idx

# Solidity / Hardhat toolchain
# package-lock.json is deliberately NOT ignored: CLAUDE.md section 12 requires
# pinned dependencies for a reproducible build.
node_modules/
contracts/artifacts/
contracts/.cache/
